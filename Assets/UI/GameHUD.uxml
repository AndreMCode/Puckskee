<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MegatonPunch" src="project://database/Assets/UI/MegatonPunch.uxml?fileID=9197481963319205126&amp;guid=5081ddb3e1e1e7f46984fad4d01821ee&amp;type=3#MegatonPunch"/>
    <Style src="project://database/Assets/UI/GameHUD.uss?fileID=7433441132597879392&amp;guid=9f6aec0ed72e980439cb3f3a12353827&amp;type=3#GameHUD"/>
    <ui:VisualElement picking-mode="Ignore" class="hud-root">

        <ui:VisualElement name="p1-stats-container" class="stats-container p1-stats" picking-mode="Ignore">

            <ui:VisualElement class="stat-group">
                <ui:Label text="PLAYER 1" class="P1label" />
            </ui:VisualElement>
            
            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="TURNS" class="label" />
                <ui:Label name="p1-turns-value" text="0" class="valueP1" />
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="MASS" class="label" />
                <ui:VisualElement class="slider-wrapper">
                    <ui:Slider name="p1-mass-slider" low-value="1.0" high-value="2.0" value="1.8" class="stat-slider" picking-mode="Ignore" />
                    <ui:Label name="p1-mass-value" text="1.8" class="slider-value-label" style="color: #FF0000" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="FRICTION" class="label" />
                <ui:VisualElement class="slider-wrapper">
                    <ui:Slider name="p1-friction-slider" low-value="1.0" high-value="2.0" value="1.8" class="stat-slider" picking-mode="Ignore" />
                    <ui:Label name="p1-friction-value" text="1.8" class="slider-value-label" style="color: #FF0000" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="DISTANCE" class="label" />
                <ui:Label name="p1-distance-value" text="0.00m" class="valueP1" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="p2-stats-container" class="stats-container p2-stats" picking-mode="Ignore">

            <ui:VisualElement class="stat-group">
                <ui:Label text="PLAYER 2" class="P2label" />
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="TURNS" class="label" />
                <ui:Label name="p2-turns-value" text="0" class="valueP2" />
            </ui:VisualElement>
            
            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="MASS" class="label" />
                <ui:VisualElement class="slider-wrapper">
                    <ui:Slider name="p2-mass-slider" low-value="1.0" high-value="2.0" value="1.8" class="stat-slider" picking-mode="Ignore" />
                    <ui:Label name="p2-mass-value" text="1.8" class="slider-value-label" style="color: #FF8000" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="FRICTION" class="label" />
                <ui:VisualElement class="slider-wrapper">
                    <ui:Slider name="p2-friction-slider" low-value="1.0" high-value="2.0" value="1.8" class="stat-slider" picking-mode="Ignore" />
                    <ui:Label name="p2-friction-value" text="1.8" class="slider-value-label" style="color: #FF8000" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stat-group" style="margin-top: 10px;">
                <ui:Label text="DISTANCE" class="label" />
                <ui:Label name="p2-distance-value" text="0.00m" class="valueP2" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:Label name="player-label" text="PLAYER 1" picking-mode="Ignore" class="player-banner" style="display: none;"/>

        <ui:VisualElement name="medal-container" class="medal-container" style="display: none;">
            <ui:Label name="medal-label" text="GOLD"/>
            <ui:Label text="CLEAR!" class="label" style="font-size: 32px;"/>
            <ui:Label name="math-breakdown-label" class="math-breakdown" />
        </ui:VisualElement>

        <ui:VisualElement name="offset-slider-container" class="offset-slider-container" style="display: none;">
            <ui:VisualElement class="slider-track">
                <ui:VisualElement class="center-marker"/>
                <ui:VisualElement name="offset-dot" class="offset-dot"/>
            </ui:VisualElement>
            <ui:Label text="APPLY SPIN" class="label" style="font-size: 14px; margin-top: 5px;"/>
        </ui:VisualElement>

    </ui:VisualElement>
    <ui:Instance template="MegatonPunch" name="MegatonPunchTemplate"/>
</ui:UXML>
