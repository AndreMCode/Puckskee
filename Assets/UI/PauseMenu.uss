.pause-root {
    flex-grow: 1;
    background-color: rgba(9, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.pause-panel {
    background-color: #090000;
    border-width: 2px;
    border-color: #FF0000;
    border-radius: 15px;
    padding: 30px;
    align-items: center;
}

.pause-title {
    font-size: 40px;
    color: #FF0000;
    margin-bottom: 20px;
}

.pause-button {
    width: 200px;
    height: 50px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.1);
    border-width: 1px;
    border-color: #FF0000;
    border-radius: 8px;
    color: #FF8000;
    font-size: 18px;
    transition-duration: 0.2s;
}

.pause-button:hover, .pause-button:focus {
    background-color: rgba(0, 0, 0, 0.2);
    border-color: #FF8000;
    color: #FF0000;
    scale: 1.05;
}

.pause-button:active {
    background-color: rgba(0, 0, 0, 0.3);
    color: #FFFFFF;
    border-color: #FFFFFF;
}

.settings-panel {
    width: 600px;
    max-height: 900px;
}

.slider-container {
    width: 80%;
    margin-bottom: 8px;
}

.slider-label {
    color: #FFFFFF;
    font-size: 15px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}