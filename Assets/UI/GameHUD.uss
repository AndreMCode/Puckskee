.hud-root {
    flex-grow: 1;
}

.stats-container {
    position: absolute;
    top: 20px;
    width: 180px;
    background-color: rgba(9, 0, 0, 0.85);
    padding: 15px;
    border-radius: 5px;
    border-width: 2px;
}

.P1label {
    color: white;
    font-size: 20px;
    align-self: center;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-color: #FF0000;
    padding-bottom: 8px;
}

.P2label {
    color: white;
    font-size: 20px;
    align-self: center;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-color: #FF0000;
    padding-bottom: 8px;
}

.p1-stats {
    left: 20px;
    border-color: #FF0000;
}

.p2-stats {
    right: 20px;
    border-color: #FF8000;
}

.stat-group {
    flex-direction: column;
}

.label {
    color: white;
    font-size: 16px;
    align-self: center;
    -unity-font-style: bold;
}

.valueP1 {
    color: #FF8000;
    font-size: 24px;
    align-self: center;
}

.valueP2 {
    color: #FF8000;
    font-size: 24px;
    align-self: center;
}

.slider-wrapper {
    margin-top: 5px;
    height: 40px;
    position: relative;
    justify-content: flex-start;
}

.stat-slider {
    margin: 0;
    flex-grow: 1;
}

.slider-value-label {
    position: absolute;
    top: -20px;
    left: 50%;
    translate: -50% 0;
    color: #FF8000;
    font-size: 16px;
    -unity-font-style: bold;
}

.player-banner {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: #FF8000;
    background-color: rgba(9, 0, 0, 0.5);
    padding: 10px 30px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FF0000;
}

.medal-container {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: rgba(9, 0, 0, 0.95);
    padding: 30px;
    border-radius: 15px;
    border-width: 4px;
    border-color: #FF0000;
    align-items: center;
}

#medal-label {
    color: #FF8000;
    font-size: 48px;
    -unity-font-style: bold;
}

.math-breakdown {
    color: white;
    font-size: 18px;
    -unity-font-style: italic;
    margin-top: 10px;
}

.offset-slider-container {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 15px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #FF0000;
}

.slider-track {
    width: 300px;
    height: 4px;
    background-color: #333;
    justify-content: center;
}

.center-marker {
    width: 2px;
    height: 10px;
    background-color: white;
    position: absolute;
    left: 50%;
    translate: -50% 0;
}

.offset-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #FF8000;
    position: absolute;
    left: 50%;
    translate: -50% 0;
}
