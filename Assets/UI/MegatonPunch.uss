.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.meter-container {
    width: 600px;
    height: 350px;
    background-color: rgba(0, 0, 0, 0.98);
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-around;
    padding: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FF0000;
    margin-bottom: 20px;
}

.meter-wrapper {
    align-items: center;
}

.label {
    color: white;
    -unity-font-style: bold;
    font-size: 32px;
    margin-bottom: 10px;
}

.score-label {
    color: #FF8000;
    -unity-font-style: bold;
    font-size: 24px;
    margin-top: 15px;
    -unity-text-align: middle-center;
}

PendulumMeter {
    width: 200px;
    height: 100px;
}

FillMeter {
    width: 60px;
    height: 200px;
}

OrbitLoop {
    width: 200px;
    height: 200px;
}
